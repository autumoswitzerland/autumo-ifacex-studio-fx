<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.autumo.ifacex.studio</groupId>
        <artifactId>autumo-ifacex-studio-fx</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>autumo-ifacex-studio-ui</artifactId>
    <packaging>jar</packaging>
    <name>ifaceX Studio FX :: UI</name>
    <description>JavaFX user interface (PoC): FXML shell + metadata-driven forms</description>

    <dependencies>
        <dependency>
            <groupId>ch.autumo.ifacex.studio</groupId>
            <artifactId>autumo-ifacex-studio-core</artifactId>
        </dependency>

        <!-- autumo-ui rapid JavaFX framework: application shell (lifecycle, installer,
             licensing/registration, i18n, theming). Its own JavaFX is excluded so we use
             the Studio's JavaFX 25.x; autumo-commons/autumo-registration arrive transitively. -->
        <dependency>
            <groupId>ch.autumo.commons</groupId>
            <artifactId>autumo-ui</artifactId>
            <version>1.2.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ch.autumo.ifacex.studio.ui.Launcher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
