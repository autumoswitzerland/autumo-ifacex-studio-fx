<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.autumo.ifacex.studio</groupId>
        <artifactId>autumo-ifacex-studio-fx</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>autumo-ifacex-studio-spike</artifactId>
    <packaging>jar</packaging>
    <name>ifaceX Studio FX :: autumo-ui spike</name>
    <description>Spike: Studio shell built on the autumo-ui framework (portable mode)</description>

    <dependencies>
        <dependency>
            <groupId>ch.autumo.ifacex.studio</groupId>
            <artifactId>autumo-ifacex-studio-core</artifactId>
        </dependency>

        <!-- autumo-ui rapid JavaFX framework. Its published POM marks these as runtime
             scope (Gradle 'implementation'), so we exclude its JavaFX and pull our own 25.x. -->
        <dependency>
            <groupId>ch.autumo.commons</groupId>
            <artifactId>autumo-ui</artifactId>
            <version>1.2.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- autumo-commons and autumo-registration arrive transitively as compile
             scope (autumo-ui exposes them via 'api'); no need to declare them here. -->

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ch.autumo.ifacex.studio.spike.Launcher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
